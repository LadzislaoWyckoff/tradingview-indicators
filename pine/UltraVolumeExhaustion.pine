// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Volume Phases (Persistence) [LuxAlgo]", "VolPhases", format = format.volume)

// --- Settings ---
int   smaLenInput      = input.int(20, "Volume SMA Length", minval = 1)
int   declineLenInput  = input.int(3, "Decline Period (On)", minval = 1)
int   exitBarsInput    = input.int(3, "Exit Period (Off)", minval = 1)
float thresholdInput   = input.float(25.0, "Low Volume Threshold (%)")
int   lookbackInput    = input.int(100, "Lookback Period")
float spikeMultInput   = input.float(1.5, "Spike Multiplier", minval = 1.0)
bool  showBarsInput    = input.bool(true, "Show Volume Bars")

// --- Logic ---
float vSma = ta.sma(volume, smaLenInput)
float lowLvl = ta.percentile_linear_interpolation(vSma, lookbackInput, thresholdInput)

// 1. Условия "Включения" фаз
bool isFallingNow = ta.falling(vSma, declineLenInput)
bool isExtLowNow  = vSma < lowLvl

// 2. Условие "Выключения" (3 бара объема выше SMA)
var int volAboveSmaCounter = 0
volAboveSmaCounter := volume > vSma ? volAboveSmaCounter + 1 : 0
bool exitSignal = volAboveSmaCounter >= exitBarsInput

// 3. Условие "Всплеска" (Spike)
bool isSpike = volume > vSma * spikeMultInput

// --- State Machine ---
// 0: Normal, 1: Decline (Orange), 2: Exhaustion (Red)
var int phaseState = 0 

if exitSignal
    phaseState := 0
else
    if isFallingNow and isExtLowNow
        phaseState := 2
    else if isFallingNow and phaseState == 0
        phaseState := 1

// Определение цветов
color colorBull      = #089981 // Зеленый для всплеска на покупку
color colorBear      = #f23645 // Красный для всплеска на продажу
color phaseColor     = phaseState == 2 ? colorBear : (phaseState == 1 ? #ff9800 : #5b9cf6)

// Логика цвета баров объема
color barColor = isSpike ? (close > open ? colorBull : colorBear) : color.new(chart.fg_color, 75)

// --- Visuals ---
// 1. Volume Bars
plot(showBarsInput ? volume : na, "Volume Bars", color = barColor, style = plot.style_columns)

// 2. SMA Line
p1 = plot(vSma, "Volume SMA", color = phaseColor, linewidth = 2)
p0 = plot(0, "Zero Line", display = display.none)

// 3. Shading (Fill)
fill(p1, p0, color = color.new(phaseColor, 80), title = "Phase Fill")

// 4. Threshold
plot(lowLvl, "Low Threshold", color = color.new(chart.fg_color, 80))

// 5. Signal Point
plotshape(phaseState == 2 and phaseState[1] != 2, "Exhaustion Entry", shape.circle, location.bottom, colorBear)
